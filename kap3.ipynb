   "source": [
    "# Finne tangent linje\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "426b94ab",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2*x - 2\n"
     ]
    }
   ],
   "source": [
    "import sympy as sp\n",
    "\n",
    "x = sp.symbols(\"x\")\n",
    "f = 2*sp.log(x)\n",
    "\n",
    "a = 1\n",
    "\n",
    "m = sp.diff(f, x).subs(x, a)\n",
    "b = f.subs(x, a)\n",
    "\n",
    "tangent = sp.expand(b + m*(x-a))\n",
    "print(tangent)"
   ]
  }
 ],
